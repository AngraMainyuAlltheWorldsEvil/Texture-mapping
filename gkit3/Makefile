ifndef config
  config=debug
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug)
  gkit3_config = debug
  tp1_config = debug
  tp2_config = debug
  camera_config = debug
  bezier_config = debug
endif
ifeq ($(config),release)
  gkit3_config = release
  tp1_config = release
  tp2_config = release
  camera_config = release
  bezier_config = release
endif

PROJECTS := gkit3 tp1 tp2 camera bezier

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

gkit3:
ifneq (,$(gkit3_config))
	@echo "==== Building gkit3 ($(gkit3_config)) ===="
	@${MAKE} --no-print-directory -C . -f gkit3.make config=$(gkit3_config)
endif

tp1: gkit3
ifneq (,$(tp1_config))
	@echo "==== Building tp1 ($(tp1_config)) ===="
	@${MAKE} --no-print-directory -C . -f tp1.make config=$(tp1_config)
endif

tp2: gkit3
ifneq (,$(tp2_config))
	@echo "==== Building tp2 ($(tp2_config)) ===="
	@${MAKE} --no-print-directory -C . -f tp2.make config=$(tp2_config)
endif

camera: gkit3
ifneq (,$(camera_config))
	@echo "==== Building camera ($(camera_config)) ===="
	@${MAKE} --no-print-directory -C . -f camera.make config=$(camera_config)
endif

bezier: gkit3
ifneq (,$(bezier_config))
	@echo "==== Building bezier ($(bezier_config)) ===="
	@${MAKE} --no-print-directory -C . -f bezier.make config=$(bezier_config)
endif

clean:
	@${MAKE} --no-print-directory -C . -f gkit3.make clean
	@${MAKE} --no-print-directory -C . -f tp1.make clean
	@${MAKE} --no-print-directory -C . -f tp2.make clean
	@${MAKE} --no-print-directory -C . -f camera.make clean
	@${MAKE} --no-print-directory -C . -f bezier.make clean

